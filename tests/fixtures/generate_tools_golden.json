[
  {
    "name": "golden-cli_act_foo",
    "description": "Run the foo action\n\nExamples:\ngolden-cli act foo /tmp --count 3",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "args": {
          "default": [],
          "description": "Positional command line arguments\nUsage pattern: <path>",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "flags": {
          "additionalProperties": false,
          "properties": {
            "count": {
              "description": "How many times to run",
              "type": "integer"
            },
            "debug": {
              "default": false,
              "description": "Enable debug output",
              "type": "boolean"
            },
            "verbose": {
              "default": false,
              "description": "Increase output verbosity",
              "type": "boolean"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "exit_code": {
          "description": "Process exit code. The sentinel value -1 means the process was killed by a signal and the OS reported no exit code.",
          "format": "int32",
          "type": "integer"
        },
        "stderr": {
          "description": "Standard error captured from the subprocess.",
          "type": "string"
        },
        "stdout": {
          "description": "Standard output captured from the subprocess.",
          "type": "string"
        }
      },
      "required": [
        "stdout",
        "stderr",
        "exit_code"
      ],
      "type": "object"
    }
  },
